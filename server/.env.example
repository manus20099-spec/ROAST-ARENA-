# Copy this file to .env and adjust.

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Local MongoDB (docker compose up -d); use the password from the project-root .env.
# For MongoDB Atlas, replace this with your Atlas connection string.
MONGODB_URI=mongodb://STARTUPARENA:replace-with-root-env-password@127.0.0.1:27017/roast-arena?authSource=admin

# Any long random string. Required when NODE_ENV=production.
JWT_SECRET=change-me-to-a-long-random-string

# Which AI writes the roasts: fallback | gemini | claude
#   fallback = no API key needed, every roast is a labelled Fallback Roast.
AI_PROVIDER=fallback

# Only the key for your chosen provider is needed.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# Optional tuning
AI_TIMEOUT_MS=15000
AI_MAX_ATTEMPTS=3

# Set to false only for local debugging
RATE_LIMIT_ENABLED=true
